-- 题目8： 用CTE先计算每个客户每张发票的"客户内部排名"，然后在外面只选出每个客户排名第1的发票（即每个客户金额最高的那张）。
WITH rank AS (
  SELECT 
    i.InvoiceID, 
    c.ClientName
  FROM Clients AS c JOIN Invoices AS i ON i.ClientID = c.ClientID
) SELECT ClientName
FROM rank;
